<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaLoginApplication.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaLoginApplication.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AvaloniaLoginApplication">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    
    <StackPanel Spacing="10" Margin="20">
        
        <TextBlock Text="{Binding Saluto}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBox PlaceholderText="Password..." Text="{Binding TxtPassword, Mode=TwoWay}"
                 IsEnabled="{Binding IsTxtEnabled}" PasswordChar="§" RevealPassword="False"/>
        <Button Content="{Binding BtnLog}" IsEnabled="{Binding IsBtnEnabled}" Command="{Binding BtnLogClickCommand}"></Button>
        <TextBlock Text="{Binding Avviso}"></TextBlock>
        
        <ListBox ItemsSource="{Binding Utenti}" SelectedItem="{Binding SelectedUtente, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Nome}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
    </StackPanel>
</Window>